# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# LLM Provider API Keys (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Tripwire Security & Gateway Configuration
TRIPWIRE_SECRET_KEY=your_tripwire_secret_key_here
TRIPWIRE_ALERT_WEBHOOK_URL=https://example.com/alerts/webhook
SECURITY_BLOCK_THRESHOLD=0.8

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
